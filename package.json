    "react-dom": "^18.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.19.20",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "drizzle-kit": "^0.31.5",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
