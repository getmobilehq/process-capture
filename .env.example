# Anthropic API — interview engine and per-facet spec drafting
ANTHROPIC_API_KEY=

# Model configuration (P5 — models are configuration, no model-specific code).
# Default per BUILD-REQUIREMENTS §4. Any current Claude model id works; bump to
# claude-sonnet-5 or claude-opus-4-8 via env without code changes.
MODEL=claude-sonnet-4-6
MODEL_TEMPERATURE=1
MODEL_MAX_TOKENS=4096

# SQLite file database (WAL mode). Swap to Postgres later by changing this URL
# and re-running migrations.
DATABASE_URL=postgres://postgres:magpie@localhost:5434/magpie

# Public base URL — used to build invite links BASE_URL/i/{token}
BASE_URL=http://localhost:3000

# Console access for the pilot; bcrypt-hashed at boot (pilot-grade auth).
ADMIN_PASSWORD=

# Surfaced in the privacy notice; retention enforcement is a V1.1 item.
RETENTION_DAYS=365

# Hard stop safety valve — engine moves to review at this turn count.
SESSION_MAX_TURNS=60

# Optional URL the closing screen links to for the pilot experience survey (E5).
SURVEY_URL=

# Optional voice input (V1.1): OpenAI Whisper transcription. When OPENAI_API_KEY is
# set, interviewees get a mic button that transcribes speech into the reply box for
# review before sending. NOTE: this sends informant audio to OpenAI (a third party) —
# update the privacy notice accordingly before using in a real pilot.
OPENAI_API_KEY=
TRANSCRIBE_MODEL=whisper-1

# Bounded interview (delta v1.1 R9.1). Global cap on questions asked, shown to the
# informant as a felt horizon; and a soft per-facet follow-up cap so the interview
# does not grind on one facet while others sit untouched.
QUESTION_BUDGET=25
FACET_FOLLOWUP_CAP=3

# The to-be process map (delta R5.4). Leave unset. R5.4's human verification gate
# is not built: nothing yet stops an unreviewed, machine-generated change-set
# reaching a handover report. Set to 1 only for internal analysis.
ENABLE_TOBE=
