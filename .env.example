# Anthropic API — interview engine and per-facet spec drafting
ANTHROPIC_API_KEY=

# Model configuration (P5 — models are configuration, no model-specific code).
# Default per BUILD-REQUIREMENTS §4. Any current Claude model id works; bump to
# claude-sonnet-5 or claude-opus-4-8 via env without code changes.
MODEL=claude-sonnet-4-6
MODEL_TEMPERATURE=1
MODEL_MAX_TOKENS=4096

# SQLite file database (WAL mode). Swap to Postgres later by changing this URL
# and re-running migrations.
DATABASE_URL=file:./data/app.db

# Public base URL — used to build invite links BASE_URL/i/{token}
BASE_URL=http://localhost:3000

# Console access for the pilot; bcrypt-hashed at boot (pilot-grade auth).
ADMIN_PASSWORD=

# Surfaced in the privacy notice; retention enforcement is a V1.1 item.
RETENTION_DAYS=365

# Hard stop safety valve — engine moves to review at this turn count.
SESSION_MAX_TURNS=60

# Optional URL the closing screen links to for the pilot experience survey (E5).
SURVEY_URL=
